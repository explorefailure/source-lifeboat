RB_COMPOSE_PROJECT=repository-backup
RB_STATE_DIR=/data
RB_FORGEJO_URL=http://forgejo:3000
RB_FORGEJO_PUBLIC_URL=http://127.0.0.1:3000/
RB_FORGEJO_TOKEN=
RB_FORGEJO_OWNER=repository-backup
RB_PUBLIC_URL=http://127.0.0.1:8080
RB_INSTALLATION_ID=replace-with-a-unique-id
# Optional legacy credential for existing installations. New local installs create a password in Settings.
RB_LOGIN_TOKEN=
# Required for initial setup through Docker or a remote URL; remove after creating the owner.
RB_SETUP_TOKEN=
RB_APP_PORT=8080
RB_FORGEJO_PORT=3000
RB_MAX_FILE_BYTES=2147483648
RB_MAX_TOTAL_BYTES=10737418240
RB_FORGEJO_MAX_ATTACHMENT_MIB=2048
RB_FORGEJO_MAX_ATTACHMENTS=1000

# Optional fallback; the owner GUI Settings page takes precedence.
RB_GITHUB_TOKEN=

# Public OAuth Client ID; no client secret is required.
RB_GITHUB_CLIENT_ID=Ov23lid8jIzZrxu2Ye6d
